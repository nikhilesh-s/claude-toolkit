<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nik.claude-toolkit-sync</string>

  <!-- launchd, not cron. cron on macOS does not fire jobs missed while the
       machine was asleep; launchd runs a StartCalendarInterval job as soon as
       the machine wakes. A laptop that is shut at 09:30 would simply skip a
       cron job that day. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/niks/claude-toolkit/scripts/nik_daily_sync.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- Do not run on load/login: loading it should not trigger a sync. -->
  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>/Users/niks/claude-toolkit</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd gives a job a minimal PATH. git, python3, node and the claude
         binary all live in /opt/homebrew/bin, so name it explicitly. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/niks/.local/bin</string>
    <key>HOME</key>
    <string>/Users/niks</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/niks/Library/Logs/claude-toolkit/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/niks/Library/Logs/claude-toolkit/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
